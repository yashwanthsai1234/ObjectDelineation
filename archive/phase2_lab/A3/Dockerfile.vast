# Candidate Vast.ai training image for Phase 2 (lab evidence for docs/research/notes/Phase 2 SFT/A3_vast_gpus.md).
#
# Layer plan (each layer changes less often than the one above it):
#   1. pinned base (python:3.12-slim-trixie multi-arch index digest, as experiments/phase1/bench/Dockerfile)
#   2. OS tools: compiler + CMake + Ninja (objdel._polycore builds from source on the box, ~20 s on x86 per M9),
#      openssh-server (Vast "ssh" launch mode injects its own setup but needs a typical sshd-compatible image),
#      rsync (vastai copy and our pull scripts use rsync over ssh), tmux, procps
#   3. the Mac's exact pins (uv pip freeze of .venv, same file x86.sh generates); torch 2.14.1 comes from PyPI,
#      whose Linux x86_64 wheel is the CUDA 13.0 build (cuda-toolkit==13.0.3, cuDNN 9.24 as pip packages), so no
#      CUDA base image is needed: the host's driver (>= 580 for CUDA 13.0) is mounted by the NVIDIA container runtime
#   4. the objdel manylinux wheel built by cibuildwheel (x86.sh step 5), installed --no-deps
#
# Code is NOT baked in here: the repo snapshot (git ls-files, no data/) is copied per run and installed editable,
# exactly as x86.sh does, so a code change never rebuilds or re-pushes the 4+ GB dependency layers.
#
# References:
#   torch 2.14.1 Linux wheel metadata (CUDA 13.0 deps): https://pypi.org/pypi/torch/2.14.1/json
#   CUDA 13.0 minimum driver (>= 580): https://docs.nvidia.com/cuda/cuda-toolkit-release-notes/index.html
#   NVIDIA container runtime env vars: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/docker-specialized.html
#   Vast launch modes (ssh/jupyter override the entrypoint; onstart instead): https://docs.vast.ai/guides/instances/connect/overview
#   Vast Docker environment (env vars, ports, /etc/environment): https://docs.vast.ai/guides/instances/docker-environment
#   uv in Docker: https://docs.astral.sh/uv/guides/integration/docker/
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build openssh-server rsync tmux procps ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt /opt/requirements.txt
RUN uv venv --python /usr/local/bin/python3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python -r /opt/requirements.txt

# Optional: a release wheel (cibuildwheel, x86.sh step 5). Without one, the box installs the code snapshot editable.
COPY wheels/ /opt/wheels/
RUN if ls /opt/wheels/objdel-*.whl > /dev/null 2>&1; then \
        uv pip install --python /opt/venv/bin/python --no-deps /opt/wheels/objdel-*.whl; fi

# NVIDIA_*: harmless if the runtime already sets them. HF_HOME on the container disk (sized at rent time).
ENV PATH=/opt/venv/bin:$PATH \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/workspace/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false
WORKDIR /workspace
