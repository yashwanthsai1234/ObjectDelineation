# syntax=docker/dockerfile:1
# vllm_native: the single-env image (D15; renamed from "phase3" and built for RL R2, owner 2026-11-06), promoted
# from lab/B5/Dockerfile.phase3: training + vLLM
# colocate in one re-pinned venv. /opt/venv = the Mac's pins with torch 2.13.0, torchvision 0.28.0, transformers 5.19.0
# + vllm==0.32.0, and two uv overrides that keep the hash-relevant pins: numba==0.68.0 and numpy==2.5.4 (B5 Q1).
# Re-run the fast suite and `xarch_hashes --strict` on every re-pin. Build context (build_images.sh):
# vllm_native.txt, vllm_native.override. Code and data are never baked in.
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build openssh-server rsync tmux procps ca-certificates curl age \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1

COPY vllm_native.txt vllm_native.override /opt/
RUN uv venv --python /usr/local/bin/python3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python -r /opt/vllm_native.txt --override /opt/vllm_native.override

ENV PATH=/opt/venv/bin:$PATH \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/workspace/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false
WORKDIR /workspace
