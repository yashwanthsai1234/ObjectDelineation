# syntax=docker/dockerfile:1
# Phase 2 Vast image (PLAN §4.3, D15), promoted from lab/B5/Dockerfile.phase2 + lab/A3/Dockerfile.vast. One image, two
# venvs; code and data are never baked in (the repo snapshot is rsynced per session and installed editable):
#   /opt/vllm  offline K-sampler only: the vllm==0.32.0 lock (torch 2.13.0, transformers 5.19.0); objdel never here
#   /opt/venv  training env = the Mac's `uv pip freeze` (torch 2.14.1 cu130, transformers 5.20.1, TRL 1.16.0, numpy
#              2.5.4, numba 0.68.0) + image-only Qwen3.5 GDN extras (cannot install on macOS; nothing in objdel imports
#              them, so xarch_hashes is unaffected): flash-linear-attention, kernels, and causal-conv1d when a prebuilt
#              wheel exists (no nvcc in the slim base; otherwise /opt/causal_conv1d.MISSING and the `kernels` hub route).
#              The extras are installed under the freeze as constraints, so they can never move a pinned version.
#              UNVERIFIED for torch 2.14.1 / cu130 until build_images.sh + image_check.sh run (R0 step 3).
# No CUDA base image: the torch wheels carry the CUDA 13.0 user space; the host runtime injects the driver (>= 580).
# Build context (build_images.sh): train.txt, vllm.txt. Stages: base -> sampler (--target sampler) -> phase2.
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build openssh-server rsync tmux procps ca-certificates curl age \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/workspace/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false
WORKDIR /workspace

FROM base AS sampler
COPY vllm.txt /opt/requirements-vllm.txt
RUN uv venv --python /usr/local/bin/python3.12 /opt/vllm \
    && uv pip install --python /opt/vllm/bin/python -r /opt/requirements-vllm.txt

FROM sampler AS phase2
COPY train.txt /opt/requirements.txt
RUN uv venv --python /usr/local/bin/python3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python -r /opt/requirements.txt
# Extras pinned here (latest on PyPI 2026-10-20), so the p2-<pinhash> tag (it hashes this file) names one image (BK4-15)
RUN uv pip install --python /opt/venv/bin/python -c /opt/requirements.txt flash-linear-attention==0.5.2 kernels==0.17.2 \
    && { uv pip install --python /opt/venv/bin/python -c /opt/requirements.txt --no-build-isolation causal-conv1d==1.7.0 \
         || echo "no causal-conv1d wheel for these pins: kernels hub route" > /opt/causal_conv1d.MISSING; } \
    && uv pip freeze --python /opt/venv/bin/python > /opt/venv.freeze.txt
ENV PATH=/opt/venv/bin:$PATH
