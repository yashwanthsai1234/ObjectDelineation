<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PLAN §4.5: launchd job for pull.sh every 1200 s. Install: sed "s#__REPO__#$PWD#g" this file >
     ~/Library/LaunchAgents/com.objdel.vast.pull.plist && launchctl load ~/Library/LaunchAgents/com.objdel.vast.pull.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.objdel.vast.pull</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/experiments/phase2/vast/pull.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartInterval</key><integer>1200</integer>
  <key>StandardOutPath</key><string>__REPO__/experiments/phase2/vast/pull.launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO__/experiments/phase2/vast/pull.launchd.log</string>
</dict>
</plist>
