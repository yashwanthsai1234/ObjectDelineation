# syntax=docker/dockerfile:1
# Phase 2 Vast image (PLAN §4.3, D15). One image, two venvs; code and data are never baked in (the repo snapshot is
# rsynced per session and installed editable):
#   /opt/vllm  offline K-sampler only: the vllm==0.32.0 lock (torch 2.13.0, transformers 5.19.0); objdel never here
#   /opt/venv  training env = locks/train.txt: pyproject base + [train] + build backend, pinned to the Mac's versions
#              (torch 2.14.1 cu130, transformers 5.20.1, TRL (version pinned in pyproject.toml), numpy 2.5.4, numba 0.68.0)
# Layers (2026-11-03): no layer above ~2 GB. The earlier image built both venvs in one RUN and hardlinked their shared
# CUDA wheels: one 5.61 GB layer of 5.88 that kept restarting on weak hosts (6 of 9 launches past the 15 min timeout).
# Each venv now installs in four layers (cuBLAS + cuDNN, the other CUDA wheels, torch, the rest); the shared CUDA
# wheels are stored once per venv (~1.5 GB more in total), pulled three layers at a time. The Qwen3.5 / LFM-only
# extras (causal-conv1d build stage, flash-linear-attention, kernels) are gone with those models. exclude-vllm.txt
# drops the CUDA 12 libs and video decoding vllm pins; each venv's last RUN imports its entry points, so a bad lock
# fails the build. No CUDA base image: the torch wheels carry the CUDA 13.0 user space; the host injects the driver
# (>= 580). Build context (build_images.sh, from locks/): train.txt, vllm.txt, exclude-vllm.txt.
# Stages: base -> sampler (--target sampler, vLLM only); base -> phase2.
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build openssh-server rsync tmux procps ca-certificates curl age \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/workspace/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false
WORKDIR /workspace

FROM base AS sampler
COPY vllm.txt /opt/requirements-vllm.txt
RUN uv venv --python /usr/local/bin/python3.12 /opt/vllm \
    && uv pip install --python /opt/vllm/bin/python -r /opt/requirements-vllm.txt

FROM base AS phase2
COPY train.txt /opt/requirements.txt
COPY vllm.txt /opt/requirements-vllm.txt
COPY exclude-vllm.txt /opt/
RUN uv venv --python /usr/local/bin/python3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-deps \
        $(grep -oE '^nvidia-(cublas|cudnn)[^=]*==[^ ]+' /opt/requirements.txt)
RUN uv pip install --python /opt/venv/bin/python --no-deps \
        $(grep -oE '^(nvidia|cuda)-[^=]+==[^ ]+' /opt/requirements.txt | grep -vE '^nvidia-(cublas|cudnn)')
RUN uv pip install --python /opt/venv/bin/python --no-deps \
        $(grep -oE '^(torch|torchvision|triton)==[^ ]+' /opt/requirements.txt)
RUN uv pip install --python /opt/venv/bin/python -r /opt/requirements.txt \
    && /opt/venv/bin/python -c "import torch, torchvision, transformers, trl, peft, datasets, pandas, numba, cv2, scipy" \
    && uv pip freeze --python /opt/venv/bin/python > /opt/venv.freeze.txt
RUN uv venv --python /usr/local/bin/python3.12 /opt/vllm \
    && uv pip install --python /opt/vllm/bin/python --no-deps \
        $(grep -oE '^nvidia-(cublas|cudnn)[^=]*==[^ ]+' /opt/requirements-vllm.txt)
RUN uv pip install --python /opt/vllm/bin/python --no-deps \
        $(grep -oE '^(nvidia|cuda)-[^=]+==[^ ]+' /opt/requirements-vllm.txt | grep -vE '^nvidia-(cublas|cudnn)' \
            | grep -vFf /opt/exclude-vllm.txt)
RUN uv pip install --python /opt/vllm/bin/python --no-deps \
        $(grep -oE '^(torch|torchvision|triton)==[^ ]+' /opt/requirements-vllm.txt)
RUN uv pip install --python /opt/vllm/bin/python -r /opt/requirements-vllm.txt --excludes /opt/exclude-vllm.txt \
    && /opt/vllm/bin/python -c "import vllm, vllm.entrypoints.llm" \
    && rm /opt/exclude-vllm.txt
ENV PATH=/opt/venv/bin:$PATH
